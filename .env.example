# Local development defaults. Copy this file to .env and fill in the secrets.
PORT=3001
NODE_ENV=development
DATABASE_PATH=./capsules.db
BASE_URL=http://localhost:5173

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# From your GitHub OAuth app (callback: http://localhost:5173/api/auth/github/callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=